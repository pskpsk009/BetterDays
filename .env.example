# Copy this file to .env.local and fill in your own Supabase project values.
#   cp .env.example .env.local
# .env.local is gitignored. Never commit real keys.
#
# Find both values in Supabase: Project Settings -> API (or "Connect").
# The publishable (anon) key is safe in the app because every table is
# protected by row-level security. Never put the service_role key here.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
